<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
body{margin:0;background:#0e0f14}
a{color:#2ee6f0;text-decoration:none}a:hover{color:#f3ecdd}
.root{position:relative;background:#0e0f14;color:#f3ecdd;font-family:'IBM Plex Mono',monospace;font-size:14px;line-height:1.6;overflow:hidden}
.wrap{position:relative;z-index:2;max-width:1180px;margin:0 auto;padding:0 32px;box-sizing:border-box}
.h{font-family:'Outfit',sans-serif;font-weight:800;letter-spacing:-.035em;margin:0;line-height:.9}
.lb{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#9aa0b4}
.crt{text-shadow:-3px 0 rgba(255,74,61,.75),3px 0 rgba(46,230,240,.75),0 0 22px rgba(243,236,221,.5);animation:fl 5s infinite}
.gc{color:#2ee6f0;text-shadow:0 0 24px rgba(46,230,240,.6)}
.gy{color:#ffd21a;text-shadow:0 0 24px rgba(255,210,26,.55)}
.gr{color:#ff4a3d;text-shadow:0 0 24px rgba(255,74,61,.55)}
.gg{color:#2fe27a;text-shadow:0 0 24px rgba(47,226,122,.55)}
.p{background:#161821;border:2px solid #2a2d3a;border-radius:20px;box-sizing:border-box;box-shadow:0 0 40px rgba(46,230,240,.06)}
.rs{height:12px;background:linear-gradient(#2ee6f0 0 25%,#2fe27a 25% 50%,#ffd21a 50% 75%,#ee2b2b 75%)}
.row{display:grid;grid-template-columns:1.1fr 2fr 1fr 1fr;gap:12px;padding:14px 22px;border-top:1px dashed #3a3e50;align-items:center}
.r3{grid-template-columns:1fr 1.4fr 2fr}
.btn{display:inline-flex;align-items:center;min-height:46px;padding:0 26px;border-radius:999px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;font-size:13px}
.tag{display:inline-block;padding:4px 14px;border:1px solid #4a4f66;border-radius:999px;margin:0 8px 8px 0;font-size:13px}
.grid{display:grid;gap:24px}
.sec{padding-bottom:72px}
.t{font-size:64px;margin:14px 0 28px}
@keyframes fl{0%,92%,100%{opacity:1}94%{opacity:.82}96%{opacity:1}98%{opacity:.9}}
@media (prefers-reduced-motion:reduce){.crt{animation:none}}
@media (max-width:860px){.g2{grid-template-columns:1fr !important}.row{grid-template-columns:1fr 1fr}.r3{grid-template-columns:1fr}.nav,.str{display:none !important}.hp{padding-left:0 !important}.hh{font-size:64px !important}.t{font-size:44px}}
</style>
</helmet>

