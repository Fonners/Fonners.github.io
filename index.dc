<div class="rs"></div>
<div style="padding:28px">
<div style="display:flex;justify-content:space-between"><span class="lb">Operator file</span><span class="lb gg" style="color:#2fe27a">● Online</span></div>
<div style="display:flex;justify-content:center;margin:18px 0 6px"><svg width="190" height="190" viewBox="0 0 120 120" aria-label="Badge: striped padlock shackle"><defs><filter id="g2" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="2.4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><g fill="none" stroke-width="6" filter="url(#g2)"><path d="M20 74V52a40 40 0 0 1 80 0V62" stroke="#ee2b2b"/><path d="M28 74V52a32 32 0 0 1 64 0V74" stroke="#ffd21a"/><path d="M36 74V52a24 24 0 0 1 48 0V74" stroke="#2fe27a"/><path d="M44 74V52a16 16 0 0 1 32 0V74" stroke="#2ee6f0"/></g><rect x="14" y="72" width="92" height="40" rx="8" fill="#f3ecdd" filter="url(#g2)"/><circle cx="60" cy="88" r="5" fill="#0e0f14"/><rect x="58" y="88" width="4" height="12" fill="#0e0f14"/></svg></div>
<div class="h crt" style="text-align:center;font-size:40px">José Afonso</div>
